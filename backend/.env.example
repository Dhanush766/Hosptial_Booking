# Copy this file to ".env" and fill in your own values.
# The real ".env" file must NEVER be committed to Git.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string

# True only while developing. Must be False in production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "mysql" (default, required for the project) or "sqlite" (quick local testing only)
DB_ENGINE=mysql
DB_NAME=hospital_db
DB_USER=hospital_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Only used when DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
